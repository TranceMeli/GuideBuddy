# Copy this file to ".env" and adjust the values.

# Address of the Django API (only the Nuxt server calls it)
NUXT_API_BASE=http://127.0.0.1:8000/api

# Public address of this frontend (with https the login cookie is marked "secure")
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# Set to true behind a reverse proxy (Nginx, Caddy ...)
NUXT_TRUST_PROXY=false

# Optional: captcha (Cloudflare Turnstile). Also set TURNSTILE_SECRET_KEY in Django.
NUXT_PUBLIC_TURNSTILE_SITE_KEY=

# Operator for the footer, imprint and privacy policy. Without these lines the fictional
# placeholder "GuideBuddy GmbH, Musterstraße 12, 70173 Stuttgart" is shown – fill in real data
# before going live (an empty value overrides the placeholder with nothing).
# NUXT_PUBLIC_OPERATOR_NAME=
# NUXT_PUBLIC_OPERATOR_ADDRESS=
# NUXT_PUBLIC_OPERATOR_COUNTRY=
# NUXT_PUBLIC_OPERATOR_EMAIL=
NUXT_PUBLIC_HOSTING_PROVIDER=
NUXT_PUBLIC_MAIL_PROVIDER=
